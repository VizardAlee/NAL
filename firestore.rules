rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      // Check if the user has an 'Admin' role in their user document.
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    function isClient() {
        return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Client';
    }
    
    function isInvestor() {
        return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Investor';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow any authenticated user to list and read user profiles.
      // This is generally safe as user documents contain non-sensitive info.
      allow list, get: if request.auth != null;
      
      // Allow any authenticated user to create a new user document (e.g., during signup).
      allow create: if request.auth != null;

      // Only the user themself or an Admin can update a user document.
      allow update: if isOwner(userId) || isAdmin();

      // Only admins can delete users.
      allow delete: if isAdmin();
    }

    // Rules for the 'deals' collection
    match /deals/{dealId} {
        // Admins can do anything.
        // Clients can read deals (assuming they need to see deal details).
        allow read: if isAdmin() || isClient();
        allow create, update, delete: if isAdmin();
    }

    // Rules for 'fundBatches' and 'transactions'
    match /fundBatches/{batchId} {
        // Admin can do anything
        allow write: if isAdmin();
        // Investor can read their own fund batches, Admins can read all.
        allow read: if isAdmin() || (isInvestor() && resource.data.sourceId == request.auth.uid);
    }

    match /transactions/{transactionId} {
        // Admin can do anything
        allow write: if isAdmin();
        // Investor can read their own transactions, Admins can read all.
        allow read: if isAdmin() || (isInvestor() && resource.data.userId == request.auth.uid);
    }
  }
}

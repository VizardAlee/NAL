
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      // Check if the user has an 'Admin' role in their user document.
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    function isClient() {
        return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Client';
    }
    
    function isInvestor() {
        return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Investor';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Admins can read all profiles. Other users can only read their own.
      allow get: if isAdmin() || isOwner(userId);
      // Admins can list all users.
      allow list: if isAdmin();
      
      // Allow any authenticated user to create a new user document (e.g., during signup).
      // In a real app, you would likely restrict this to admins or specific backend processes.
      allow create: if request.auth != null;

      // Only the user themself or an Admin can update a user document.
      allow update: if isOwner(userId) || isAdmin();

      // Only admins can delete users.
      allow delete: if isAdmin();
    }

    // Rules for the 'deals' collection
    match /deals/{dealId} {
        // Admins can do anything.
        // Clients can read deals they are associated with.
        // Investors can read all deals (the client will filter to only show ones they've invested in).
        allow read: if isAdmin() || (isClient() && resource.data.clientId == request.auth.uid) || isInvestor();
        
        // Only Admins can create, update or delete deals
        allow create, update, delete: if isAdmin();
    }

    // Rules for the 'investments' collection
    match /investments/{investmentId} {
      // Admins can write.
      allow write: if isAdmin();
      // Admins can read all. Investors can read their own investments.
      allow read: if isAdmin() || (isInvestor() && resource.data.investorId == request.auth.uid);
    }
    
    // Rules for 'fundBatches' and 'transactions'
    match /fundBatches/{batchId} {
        // Admin can do anything
        allow write: if isAdmin();
        // Investor can read their own fund batches, Admins can read all.
        allow read: if isAdmin() || (isInvestor() && resource.data.sourceId == request.auth.uid);
    }

    match /transactions/{transactionId} {
        // Admin can do anything
        allow write: if isAdmin();
        // Investor can read their own transactions, Admins can read all.
        // Clients can read their own repayment transactions.
        allow read: if isAdmin() || (isInvestor() && resource.data.userId == request.auth.uid) || (isClient() && resource.data.userId == request.auth.uid);
    }

    // Rules for 'repayments'
    match /repayments/{repaymentId} {
      // Admins can read and update all repayments.
      allow get, update: if isAdmin();
      // Clients can create their own repayments and read their own.
      allow create: if isClient() && request.resource.data.clientId == request.auth.uid;
      allow read: if isClient() && resource.data.clientId == request.auth.uid;
      
      // A client can list their OWN repayments by querying on their clientId.
      allow list: if isClient() && request.query.where.size() > 0 && request.query.where[0].field == "clientId" && request.query.where[0].op == "==" && request.query.where[0].value == request.auth.uid;
    }
  }
}

    
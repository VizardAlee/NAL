
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      // Check if the user has an 'Admin' role in their user document.
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    function isClient() {
        return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Client';
    }
    
    function isInvestor() {
        return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Investor';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Admins can read all profiles. Other users can only read their own.
      allow get: if isAdmin() || isOwner(userId);
      // Admins can list all users.
      allow list: if isAdmin();
      
      // Allow any authenticated user to create a new user document (e.g., during signup).
      allow create: if request.auth != null;

      // Only the user themself or an Admin can update a user document.
      allow update: if isOwner(userId) || isAdmin();

      // Only admins can delete users.
      allow delete: if isAdmin();
    }

    // Rules for the 'deals' collection
    match /deals/{dealId} {
        // An investor can read a deal if they have an investment in it.
        function isInvestedInDeal() {
          return isInvestor() && exists(/databases/$(database)/documents/investments?dealId=$(dealId)&investorId=$(request.auth.uid));
        }

        // Admins can do anything.
        // Clients can read deals they are associated with.
        // Investors can read deals they are invested in.
        allow read: if isAdmin() || (isClient() && resource.data.clientId == request.auth.uid) || isInvestedInDeal();
        allow create, update, delete: if isAdmin();
    }

    match /investments/{investmentId} {
      // Admins can write
      allow write: if isAdmin();
      // Admins can read all. Investors can read their own investments.
      allow read: if isAdmin() || (isInvestor() && resource.data.investorId == request.auth.uid);
    }
    
    // Rules for 'fundBatches' and 'transactions'
    match /fundBatches/{batchId} {
        // Admin can do anything
        allow write: if isAdmin();
        // Investor can read their own fund batches, Admins can read all.
        allow read: if isAdmin() || (isInvestor() && resource.data.sourceId == request.auth.uid);
    }

    match /transactions/{transactionId} {
        // Admin can do anything
        allow write: if isAdmin();
        // Investor can read their own transactions, Admins can read all.
        allow read: if isAdmin() || (isInvestor() && resource.data.userId == request.auth.uid);
    }
  }
}

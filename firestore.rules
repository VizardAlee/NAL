rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // HELPERS
    // =========================
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userRole() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return userRole() == 'Admin';
    }

    function isClient() {
      return userRole() == 'Client';
    }

    function isInvestor() {
      return userRole() == 'Investor';
    }

    function isLegal() {
      return userRole() == 'Legal';
    }

    function isRecovery() {
      return userRole() == 'Recovery';
    }

    function isMarketer() {
      return userRole() == 'Marketer';
    }

    // =========================
    // HEALTHCHECK (REMOVE FOR PROD)
    // =========================
    match /healthcheck/{docId} {
      allow read, write: if true;
    }

    // =========================
    // USERS
    // =========================
    match /users/{userId} {

      // ✅ Admin can read all
      // ✅ User can read own profile
      // ✅ Legal can read all (if you want)
      allow get: if isAdmin() || isOwner(userId) || isLegal();

      allow list: if isAdmin() || isLegal();

      // ✅ Only signed-in user creates their own document
      allow create: if isOwner(userId);

      // ✅ Admin updates anything
      // ✅ User updates only safe fields
      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'fcmTokens',
              'name',
              'phoneNumber',
              'legalDocumentUrl'
            ])
        );

      allow delete: if isAdmin();
    }

    // =========================
    // DEALS
    // =========================
    match /deals/{dealId} {
      allow get, list: if isAdmin()
        || isLegal()
        || (isClient() && resource.data.clientId == request.auth.uid)
        || (isMarketer() && resource.data.marketerId == request.auth.uid);

      // 🚫 Investors should NOT read all deals unless required
      // If you want investors to see deals, add explicit restriction rules.

      allow create, update, delete: if isAdmin();
    }

    // =========================
    // DEAL REQUESTS
    // =========================
    match /dealRequests/{dealRequestId} {
      allow get, list, update: if isAdmin();

      allow create: if isClient()
        && request.resource.data.clientId == request.auth.uid;

      allow read: if isClient()
        && resource.data.clientId == request.auth.uid;
    }

    // =========================
    // REPAYMENTS
    // =========================
    match /repayments/{repaymentId} {

      // ✅ Admin / Legal can read all
      allow get, list: if isAdmin() || isLegal();

      // ✅ Client reads own
      allow read: if isClient()
        && resource.data.clientId == request.auth.uid;

      // ✅ Client creates repayment only for self
      // ✅ Must always be "Pending" on create
      allow create: if isClient()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == "Pending";

      // ✅ Only Admin can approve/reject/update
      allow update: if isAdmin();

      // 🚫 never allow delete from app users
      allow delete: if false;
    }

    // =========================
    // TRANSACTIONS
    // =========================
    match /transactions/{transactionId} {

      // ✅ Only Admin writes transactions
      allow write: if isAdmin();

      // ✅ Admin / Legal reads all
      allow read, list: if isAdmin()
        || isLegal()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // =========================
    // FUND BATCHES
    // =========================
    match /fundBatches/{batchId} {
      allow write: if isAdmin();

      allow read: if isAdmin()
        || (isInvestor() && resource.data.sourceId == request.auth.uid);
    }

    // =========================
    // INVESTMENTS
    // =========================
    match /investments/{investmentId} {
      allow write: if isAdmin();

      allow read, list: if isAdmin()
        || isLegal()
        || (isInvestor() && resource.data.investorId == request.auth.uid);
    }

    // =========================
    // DEPOSIT REQUESTS
    // =========================
    match /depositRequests/{depositRequestId} {
      allow get, list, update: if isAdmin();

      allow create: if isInvestor()
        && request.resource.data.investorId == request.auth.uid
        && request.resource.data.status == "Pending";

      allow read: if isInvestor()
        && resource.data.investorId == request.auth.uid;
    }

    // =========================
    // WITHDRAWAL REQUESTS
    // =========================
    match /withdrawalRequests/{requestId} {
      allow get, list, update: if isAdmin();

      allow create: if isInvestor()
        && request.resource.data.investorId == request.auth.uid
        && request.resource.data.status == "Pending";

      allow read: if isInvestor()
        && resource.data.investorId == request.auth.uid;
    }

    // =========================
    // REINVESTMENT REQUESTS
    // =========================
    match /reinvestmentRequests/{requestId} {
      allow get, list, update: if isAdmin();

      allow create: if isInvestor()
        && request.resource.data.investorId == request.auth.uid
        && request.resource.data.status == "Pending";

      allow read: if isInvestor()
        && resource.data.investorId == request.auth.uid;
    }

    // =========================
    // TERMINATION REQUESTS
    // =========================
    match /terminationRequests/{requestId} {
      allow get, list, update: if isAdmin();

      allow create: if isClient()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == "Pending";

      allow read: if isClient()
        && resource.data.clientId == request.auth.uid;
    }

    // =========================
    // ADMINISTRATIVE TRANSACTIONS
    // =========================
    match /administrativeTransactions/{transactionId} {
      allow read, write: if isAdmin();
    }

    // =========================
    // ASSETS
    // =========================
    match /assets/{assetId} {
      allow read, write: if isAdmin();
    }

    // =========================
    // TAX RECORDS
    // =========================
    match /taxRecords/{taxRecordId} {
      allow read, write: if isAdmin();
    }

    // =========================
    // PLATFORM SETTINGS (IMPORTANT)
    // =========================
    match /platformSettings/{settingId} {

      // ✅ Branding can be public
      allow read: if settingId == "branding";

      // ✅ Bank details visible only to authenticated users
      allow read: if settingId == "bankDetails" && signedIn();

      // ✅ Zakat settings should NOT be public
      allow read: if settingId == "zakat" && (isAdmin() || isLegal());

      // ✅ Only Admin updates any settings
      allow write: if isAdmin();
    }

    // =========================
    // NOTIFICATIONS
    // =========================
    match /notifications/{notificationId} {
      allow create: if isAdmin();

      allow read, update: if signedIn()
        && resource.data.recipientId == request.auth.uid;

      allow list: if isAdmin();
    }

    // =========================
    // RECOVERY TASKS + LOGS
    // =========================
    match /recoveryTasks/{taskId} {

      allow read: if isAdmin() || isLegal() || isRecovery();

      allow create, update: if isAdmin();

      match /logs/{logId} {
        allow read: if isAdmin() || isLegal() || isRecovery();
        allow create: if isAdmin() || isLegal() || isRecovery();
      }
    }

    // =========================
    // CHAT REQUESTS
    // =========================
    match /chatRequests/{requestId} {
      allow get, list, delete: if isAdmin();

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow read: if false;
    }

    // =========================
    // CONVERSATIONS + MESSAGES
    // =========================
    match /conversations/{conversationId} {

      allow create: if isAdmin();

      allow get, list, update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid in resource.data.participantIds
        );

      match /messages/{messageId} {
        allow read, create: if signedIn()
          && exists(/databases/$(database)/documents/conversations/$(conversationId))
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }
    }
  }
}

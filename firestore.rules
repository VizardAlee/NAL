rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      // Check if the user has an 'Admin' role in their user document.
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    function isClient() {
        return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Client';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Admins can list all users. Regular users cannot.
      allow list: if isAdmin();
      // Admins can get any user. Regular users can only get their own document.
      allow get: if isOwner(userId) || isAdmin();
      // Allow user creation for any authenticated session (e.g., admin creating a user).
      // This assumes roles are set securely by a trusted source (like an admin form).
      allow create: if request.auth != null;
      // Admins can update any user. Regular users can only update their own document.
      allow update: if isOwner(userId) || isAdmin();
      // Only admins can delete users.
      allow delete: if isAdmin();
    }

    // Rules for the 'deals' collection
    match /deals/{dealId} {
        // Admins can do anything.
        // Clients can read deals (assuming they need to see deal details).
        allow read: if isAdmin() || isClient();
        allow create, update, delete: if isAdmin();
    }

    // Rules for 'fundBatches' and 'transactions'
    // These are sensitive financial collections, only admins should have access.
    match /fundBatches/{batchId} {
        allow read, write: if isAdmin();
    }

    match /transactions/{transactionId} {
        allow read, write: if isAdmin();
    }

    // Deny all other reads and writes by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

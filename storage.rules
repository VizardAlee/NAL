rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      let profile = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      return signedIn() && (profile.accessRole == 'ADMIN' || (!('accessRole' in profile) && profile.role == 'Admin'));
    }

    function hasPersona(persona) {
      let profile = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      return signedIn() && (
        (('personas' in profile) && profile.personas.hasAny([persona]))
        || (persona == 'RECOVERY' && profile.role == 'Recovery')
        || (persona == 'LEGAL' && profile.role == 'Legal')
      );
    }

    function isRecoveryStatus(status) {
      return status in ['UPCOMING', 'DUE', 'OVERDUE', 'PROMISE_TO_PAY', 'BROKEN_PROMISE', 'Due_Recovery'];
    }

    function isLegalStatus(status) {
      return status in ['ESCALATED_LEGAL', 'NOTICE_PREPARATION', 'DEMAND_ISSUED', 'NEGOTIATION', 'COURT_PROCEEDINGS', 'JUDGMENT', 'SETTLED', 'Escalated_Legal'];
    }

    function canAccessCase(taskId) {
      let caseData = firestore.get(/databases/(default)/documents/recoveryTasks/$(taskId)).data;
      return isAdmin()
        || (hasPersona('RECOVERY') && isRecoveryStatus(caseData.status) && caseData.assigneeId in [null, request.auth.uid])
        || (hasPersona('LEGAL') && isLegalStatus(caseData.status) && caseData.assigneeId in [null, request.auth.uid]);
    }

    function validUpload() {
      return request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)|application/pdf');
    }

    // Final executed agreements are written and read only by authenticated
    // server actions using the Admin SDK. Even a signed-in user cannot bypass
    // the application authorization checks by guessing an archive path.
    match /agreement-archives/{allPaths=**} {
      allow read, write: if false;
    }

    match /users/{userId}/proposals/{fileName} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() && request.auth.uid == userId && validUpload();
    }

    match /users/{userId}/profile/{fileName} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if signedIn()
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)');
    }

    match /users/{userId}/guarantors/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)');
    }

    match /conversations/{conversationId}/{userId}/{fileName} {
      allow read: if signedIn()
        && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participantIds;
      allow write: if signedIn()
        && request.auth.uid == userId
        && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participantIds
        && validUpload();
    }

    match /admin/{adminId}/legal/{userId}/{fileName} {
      allow read: if signedIn() && request.auth.uid == adminId && isAdmin();
      allow write: if signedIn() && request.auth.uid == adminId && isAdmin() && validUpload();
    }

    match /case-evidence/{taskId}/{uploaderId}/{fileName} {
      allow read: if signedIn() && canAccessCase(taskId);
      allow write: if signedIn()
        && request.auth.uid == uploaderId
        && canAccessCase(taskId)
        && validUpload();
    }
  }
}

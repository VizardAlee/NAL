
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasRole(role) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role
          || (
            'roles' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny([role])
          )
        );
    }

    function hasPersona(persona) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          'personas' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.personas.hasAny([persona])
        );
    }

    function hasAccessRole(accessRole) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          ('accessRole' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accessRole == accessRole
        );
    }

    function isAdmin() {
      return hasRole('Admin') || hasAccessRole('ADMIN');
    }

    function isOwnerRole() {
      return hasAccessRole('OWNER');
    }

    function isStaffRole() {
      return hasAccessRole('STAFF');
    }

    function canAdminRead() {
      return isAdmin() || isOwnerRole();
    }

    function canManageOwnerAssignments(userId) {
      return request.auth != null
        && (isAdmin() || isOwnerRole())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accessRole', 'updatedAt']);
    }

    function isClient() {
      return hasRole('Client') || hasPersona('CLIENT');
    }
    
    function isInvestor() {
      return hasRole('Investor') || hasPersona('INVESTOR');
    }

    function isLegal() {
      return hasRole('Legal') || hasPersona('LEGAL');
    }
    
    function isRecovery() {
       return hasRole('Recovery') || hasPersona('RECOVERY');
    }
    
    function isMarketer() {
       return hasRole('Marketer') || hasPersona('MARKETER');
    }

    function isRecoveryQueueStatus(status) {
      return status in ['UPCOMING', 'DUE', 'OVERDUE', 'PROMISE_TO_PAY', 'BROKEN_PROMISE', 'Due_Recovery'];
    }

    function isLegalQueueStatus(status) {
      return status in ['ESCALATED_LEGAL', 'NOTICE_PREPARATION', 'DEMAND_ISSUED', 'NEGOTIATION', 'COURT_PROCEEDINGS', 'JUDGMENT', 'SETTLED', 'Escalated_Legal'];
    }

    function canReadOperationalCase(caseData) {
      return canAdminRead()
        || (isRecovery() && isRecoveryQueueStatus(caseData.status)
          && caseData.assigneeId in [null, request.auth.uid])
        || (isLegal() && isLegalQueueStatus(caseData.status)
          && caseData.assigneeId in [null, request.auth.uid]);
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      allow get: if canAdminRead() || isOwner(userId);
      allow list: if canAdminRead();
      
      // Allow any unauthenticated or authenticated user to create a new user document (e.g., during signup).
      allow create: if true;

      // Only the user themself or an Admin can update a user document.
      allow update: if isAdmin()
        || canManageOwnerAssignments(userId)
        || (isOwner(userId) && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens']) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phoneNumber']) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['legalDocumentUrl'])));

      // Only admins can delete users.
      allow delete: if isAdmin();
    }
    
    // Rules for the 'recoveryTasks' collection
    match /recoveryTasks/{taskId} {
      allow get, list, read: if canReadOperationalCase(resource.data);
      
      // Allow server-side updates (by admin) and log creation by assigned roles.
      allow create, update: if isAdmin();
      
      // Rules for the 'logs' sub-collection
      match /logs/{logId} {
        allow read, list: if canReadOperationalCase(get(/databases/$(database)/documents/recoveryTasks/$(taskId)).data);
        allow create, update, delete: if false;
      }

      match /evidence/{evidenceId} {
        allow read, list: if canReadOperationalCase(get(/databases/$(database)/documents/recoveryTasks/$(taskId)).data);
        allow create, update, delete: if false;
      }

      match /notices/{noticeId} {
        allow read, list: if canAdminRead()
          || (isLegal() && isLegalQueueStatus(get(/databases/$(database)/documents/recoveryTasks/$(taskId)).data.status));
        allow create, update, delete: if false;
      }

      match /expenses/{expenseId} {
        allow read, list: if canAdminRead()
          || (isLegal() && isLegalQueueStatus(get(/databases/$(database)/documents/recoveryTasks/$(taskId)).data.status));
        allow create, update, delete: if false;
      }
    }

    match /automationHealth/{healthId} {
      allow read: if canAdminRead();
      allow write: if false;
    }

    match /automationRuns/{runId} {
      allow read: if canAdminRead();
      allow write: if false;
    }


    // Rules for the 'deals' collection
    match /deals/{dealId} {
        // Admins, Investors, and Legal can list all deals. Marketers can see deals they are linked to.
        // Clients can see deals they are associated with.
        allow list: if canAdminRead() || isInvestor() || (isMarketer() && resource.data.marketerId == request.auth.uid) || (isClient() && resource.data.clientId == request.auth.uid);
        
        // Admins, Investors, Legal can get any single deal.
        // Clients can only get deals they are associated with.
        allow get: if canAdminRead() || isInvestor() || (isClient() && resource.data.clientId == request.auth.uid);
        
        // Only Admins can create, update or delete deals
        allow create, update, delete: if isAdmin();
    }

    // Rules for the 'dealRequests' collection
    match /dealRequests/{dealRequestId} {
        // Admins can read/update all requests.
        allow get, list: if canAdminRead();
        allow update: if isAdmin();
        // Clients can create their own requests and read them.
        allow create: if isClient() && request.resource.data.clientId == request.auth.uid;
        allow read: if isClient() && resource.data.clientId == request.auth.uid;
    }

    // Rules for the 'depositRequests' collection
    match /depositRequests/{depositRequestId} {
        // Admins can read/update all requests.
        allow get, list: if canAdminRead();
        allow update: if isAdmin();
        // Investors can create their own requests and read them.
        allow create: if isInvestor() && request.resource.data.investorId == request.auth.uid;
        allow read: if isInvestor() && resource.data.investorId == request.auth.uid;
    }


    // Rules for the 'investments' collection
    match /investments/{investmentId} {
      // Admins can write.
      allow write: if isAdmin();
      // Admins can read all. Investors can read their own investments. Legal can read all.
      allow read, list: if canAdminRead() || (isInvestor() && resource.data.investorId == request.auth.uid);
    }
    
    // Rules for 'fundBatches' and 'transactions'
    match /fundBatches/{batchId} {
        // Admin can do anything
        allow write: if isAdmin();
        // Investor can read their own fund batches, Admins can read all.
        allow read: if canAdminRead() || (isInvestor() && resource.data.sourceId == request.auth.uid);
    }

    match /transactions/{transactionId} {
        // Admin can do anything
        allow write: if isAdmin();
        // Investor/Client/Marketer can read their own transactions, Admins can read all.
        allow read, list: if canAdminRead() || (isOwner(resource.data.userId));
    }

    // Rules for 'repayments'
    match /repayments/{repaymentId} {
      allow get, list: if canAdminRead();
      allow update: if isAdmin();
      // Clients can create their own repayments and read their own.
      allow create: if isClient() && request.resource.data.clientId == request.auth.uid;
      allow read: if isClient() && resource.data.clientId == request.auth.uid;
    }

    // Rules for 'withdrawalRequests'
    match /withdrawalRequests/{requestId} {
      // Admins can read and update any request
      allow get, list: if canAdminRead();
      allow update: if isAdmin();

      // All users (Investors/Owners) use investorId as the primary field for their requests
      allow create: if (isInvestor() || isOwnerRole()) && request.resource.data.investorId == request.auth.uid;
      allow read: if (isInvestor() || isOwnerRole()) && resource.data.investorId == request.auth.uid;
    }

    // Rules for 'reinvestmentRequests'
    match /reinvestmentRequests/{requestId} {
      // Admins can read and update any request
      allow get, list: if canAdminRead();
      allow update: if isAdmin();

      // Investors can create their own requests
      allow create: if isInvestor() && request.resource.data.investorId == request.auth.uid;

      // Investors can read their own requests
      allow read: if isInvestor() && resource.data.investorId == request.auth.uid;
    }
    
    // Rules for 'terminationRequests'
    match /terminationRequests/{requestId} {
      // Admins can read and update any request
      allow get, list: if canAdminRead();
      allow update: if isAdmin();
      
      // Clients can create their own requests and read them
      allow create: if isClient() && request.resource.data.clientId == request.auth.uid;
      allow read: if isClient() && resource.data.clientId == request.auth.uid;
    }
    
    // Rules for 'administrativeTransactions' and 'assets'
    match /administrativeTransactions/{transactionId} {
        // Only admins can read or write administrative transactions.
        allow read: if canAdminRead();
        allow write: if isAdmin();
    }

    match /assets/{assetId} {
        // Only admins can read or write assets.
        allow read: if canAdminRead();
        allow write: if isAdmin();
    }

    match /interAccountLoans/{loanId} {
        // Owners can view; only admins can mutate loan ledger.
        allow read: if canAdminRead();
        allow write: if isAdmin();
    }

    match /platformPolicies/{policyId} {
        allow read: if canAdminRead();
        allow write: if isAdmin();
    }

    match /ownershipPartners/{partnerId} {
        allow read: if canAdminRead();
        allow write: if isAdmin();
    }

    match /ownerProfitAllocations/{allocationId} {
        allow read: if canAdminRead();
        allow write: if isAdmin();
    }

    // Rules for 'notifications'
    match /notifications/{notificationId} {
        // Notification creation is handled through trusted server actions/Admin SDK.
        allow create: if false;

        allow get, list: if request.auth != null
          && resource.data.recipientId == request.auth.uid;

        allow update: if request.auth != null
          && resource.data.recipientId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
    }

    // Rules for 'platformSettings'
    match /platformSettings/{settingId} {
        // Allow public read for settings like branding
        allow read: if true;
        // Only admins can change settings.
        allow write: if isAdmin();
    }
    
    // --- Messaging System Rules ---

    // Rules for 'chatRequests' collection
    match /chatRequests/{requestId} {
      // Admins can read, list and delete all requests.
      allow get, list: if canAdminRead();
      allow delete: if isAdmin();
      // Authenticated users can create their own chat requests.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Rules for 'conversations' collection
    match /conversations/{conversationId} {
        // Admins can do everything.
        allow get, list: if canAdminRead();
        allow create, update: if isAdmin();

        // Regular users can only read/list/update conversations they are a part of.
        allow get, list, update: if request.auth != null
            && 'participantIds' in resource.data
            && request.auth.uid in resource.data.participantIds;
    }
    
    // Rules for 'messages' subcollection
    match /conversations/{conversationId}/messages/{messageId} {
        // Users can read/create messages only if they are a participant in the parent conversation.
        allow read, create: if request.auth != null
            && exists(/databases/$(database)/documents/conversations/$(conversationId))
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
    }
  }
}

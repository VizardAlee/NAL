
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    function isClient() {
      return request.auth != null 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Client';
    }
    
    function isInvestor() {
      return request.auth != null 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Investor';
    }

    function isLegal() {
      return request.auth != null 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Legal';
    }
    
    function isRecovery() {
       return request.auth != null 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Recovery';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Admins can get any user. Owners can get their own data. Legal can read any user.
      allow get: if isAdmin() || isOwner(userId) || isLegal();
      // Admins and Legal can list all users.
      allow list: if isAdmin() || isLegal();
      
      // Allow any authenticated user to create a new user document (e.g., during signup).
      // In a real app, you would likely restrict this to admins or specific backend processes.
      allow create: if request.auth != null;

      // Only the user themself or an Admin can update a user document.
      allow update: if isAdmin() || (isOwner(userId) && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens']) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phoneNumber']) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['legalDocumentUrl'])));

      // Only admins can delete users.
      allow delete: if isAdmin();
    }

    // Rules for the 'deals' collection
    match /deals/{dealId} {
        // Admins, Investors, and Legal can list all deals.
        allow list: if isAdmin() || isInvestor() || (request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Legal');
        
        // Admins, Investors, Legal can get any single deal.
        // Clients can only get deals they are associated with.
        allow get: if isAdmin() || isInvestor() || isLegal() || (isClient() && resource.data.clientId == request.auth.uid);
        
        // Only Admins can create, update or delete deals
        allow create, update, delete: if isAdmin();
    }
    
    // Rules for the 'recoveryTasks' collection
    match /recoveryTasks/{taskId} {
      allow read, list: if isAdmin() 
        || (isRecovery() && resource.data.status == 'Due_Recovery') 
        || (isLegal()); // Legal can see all recovery tasks
      allow update: if isAdmin();
      
       // Rules for the 'logs' sub-collection
      match /logs/{logId} {
      	allow read, list: if isAdmin() || isLegal() || isRecovery();
        // Allow creating a log if the user is an Admin, or a Recovery/Legal user assigned to the task
        allow create: if isAdmin() || 
        							 (isRecovery() && get(/databases/$(database)/documents/recoveryTasks/$(taskId)).data.status == 'Due_Recovery') ||
                       (isLegal() && get(/databases/$(database)/documents/recoveryTasks/$(taskId)).data.status == 'Escalated_Legal');
      }
    }

    // Rules for the 'dealRequests' collection
    match /dealRequests/{dealRequestId} {
        // Admins can read/update all requests.
        allow get, list, update: if isAdmin();
        // Clients can create their own requests and read them.
        allow create: if isClient() && request.resource.data.clientId == request.auth.uid;
        allow read: if isClient() && resource.data.clientId == request.auth.uid;
    }

    // Rules for the 'depositRequests' collection
    match /depositRequests/{depositRequestId} {
        // Admins can read/update all requests.
        allow get, list, update: if isAdmin();
        // Investors can create their own requests and read them.
        allow create: if isInvestor() && request.resource.data.investorId == request.auth.uid;
        allow read: if isInvestor() && resource.data.investorId == request.auth.uid;
    }


    // Rules for the 'investments' collection
    match /investments/{investmentId} {
      // Admins can write.
      allow write: if isAdmin();
      // Admins can read all. Investors can read their own investments. Legal can read all.
      allow read, list: if isAdmin() || (isInvestor() && resource.data.investorId == request.auth.uid) || isLegal();
    }
    
    // Rules for 'fundBatches' and 'transactions'
    match /fundBatches/{batchId} {
        // Admin can do anything
        allow write: if isAdmin();
        // Investor can read their own fund batches, Admins can read all.
        allow read: if isAdmin() || (isInvestor() && resource.data.sourceId == request.auth.uid);
    }

    match /transactions/{transactionId} {
        // Admin can do anything
        allow write: if isAdmin();
        // Investor can read their own transactions, Admins can read all.
        // Clients can read their own repayment transactions. Legal can read all.
        allow read, list: if isAdmin() || (isInvestor() && resource.data.userId == request.auth.uid) || (isClient() && resource.data.userId == request.auth.uid) || isLegal();
    }

    // Rules for 'repayments'
    match /repayments/{repaymentId} {
      // Admins can read and update all repayments. Legal can read all.
      allow get, list: if isAdmin() || isLegal();
      allow update: if isAdmin();
      // Clients can create their own repayments and read their own.
      allow create: if isClient() && request.resource.data.clientId == request.auth.uid;
      allow read: if isClient() && resource.data.clientId == request.auth.uid;
    }

    // Rules for 'withdrawalRequests'
    match /withdrawalRequests/{requestId} {
      // Admins can read and update any request
      allow get, update, list: if isAdmin();

      // Investors can create their own requests
      allow create: if isInvestor() && request.resource.data.investorId == request.auth.uid;

      // Investors can read their own requests
      allow read: if isInvestor() && resource.data.investorId == request.auth.uid;
    }

    // Rules for 'reinvestmentRequests'
    match /reinvestmentRequests/{requestId} {
      // Admins can read and update any request
      allow get, update, list: if isAdmin();

      // Investors can create their own requests
      allow create: if isInvestor() && request.resource.data.investorId == request.auth.uid;

      // Investors can read their own requests
      allow read: if isInvestor() && resource.data.investorId == request.auth.uid;
    }
    
    // Rules for 'terminationRequests'
    match /terminationRequests/{requestId} {
      // Admins can read and update any request
      allow get, update, list: if isAdmin();
      
      // Clients can create their own requests and read them
      allow create: if isClient() && request.resource.data.clientId == request.auth.uid;
      allow read: if isClient() && resource.data.clientId == request.auth.uid;
    }
    
    // Rules for 'administrativeTransactions' and 'assets'
    match /administrativeTransactions/{transactionId} {
        // Only admins can read or write administrative transactions.
        allow read, write: if isAdmin();
    }

    match /assets/{assetId} {
        // Only admins can read or write assets.
        allow read, write: if isAdmin();
    }

    // Rules for 'notifications'
    match /notifications/{notificationId} {
        // Allow any authenticated user to create a notification, as long as it's for an Admin.
        // This is secure because we check the role of the recipient.
        allow create: if request.auth != null; // Notification creation logic is handled server-side now.
          
        // Users can only read/update notifications intended for them
        allow read, update: if request.auth != null && resource.data.recipientId == request.auth.uid;

        // Admins can list notifications (to see all, for debugging if needed, but UI filters by recipientId)
        allow list: if isAdmin();
    }

    // Rules for 'platformSettings'
    match /platformSettings/{settingId} {
        // Allow public read for settings like branding
        allow read: if true;
        // Only admins can change settings.
        allow write: if isAdmin();
    }
    
    // --- Messaging System Rules ---

    // Rules for 'chatRequests' collection
    match /chatRequests/{requestId} {
      // Admins can read, list and delete all requests.
      allow get, list, delete: if isAdmin();
      // Authenticated users can create their own chat requests.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Rules for 'conversations' collection
    match /conversations/{conversationId} {
        // Admins can do everything.
        allow create, get, list, update: if isAdmin();

        // Regular users can only read/list/update conversations they are a part of.
        allow get, list, update: if request.auth != null
            && 'participantIds' in resource.data
            && request.auth.uid in resource.data.participantIds;
    }
    
    // Rules for 'messages' subcollection
    match /conversations/{conversationId}/messages/{messageId} {
        // Users can read/create messages only if they are a participant in the parent conversation.
        allow read, create: if request.auth != null
            && exists(/databases/$(database)/documents/conversations/$(conversationId))
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
    }
  }
}
